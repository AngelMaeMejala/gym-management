{
  "name": "gym-management",
  "private": true,
  "scripts": {
    "dev:api": "npm run build:api && npm start",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p backend/tsconfig.json",
    "seed:equipment": "npm run build:api && node dist/api/seed-equipment.js",
    "build:web": "vite build --config frontend/vite.config.ts",
    "start": "node dist/api/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.8.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.511.0",
    "mysql2": "^3.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.22"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
