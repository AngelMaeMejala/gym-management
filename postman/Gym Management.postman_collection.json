            "url": "{{baseUrl}}/auth/me/profile-picture",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{memberToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "picture",
                  "type": "file",
                  "src": "postman/fixtures/profile.png"
                }
              ]
            }
